# ---------------------------------------------------------------------------
# jword environment variables. Copy to .env.local (web) and never commit real values.
# `supabase status -o env` prints the local values after `pnpm db:start`.
# ---------------------------------------------------------------------------

# Public Supabase project URL. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public (anon / publishable) Supabase key. Safe for the browser; RLS still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Owner timezone for "today" defaults (decision 011). Web and MCP must agree.
JWORD_TIMEZONE=America/Chicago

# Optional: if set, the web app rejects any signed-in user other than this id.
# Find it under Authentication -> Users in Supabase Studio, or from `pnpm owner:create`.
JWORD_OWNER_USER_ID=

# Id of the jword capture Chrome extension allowed to call /api/extension/* (decision 017).
# Not a secret: it is derived from the public `key` in packages/extension/static/manifest.json
# (currently bnjlbmpmikpggohfhmfpddeeokbjpkbk). Unset disables the capture API.
JWORD_EXTENSION_ID=

# ---------------------------------------------------------------------------
# Local MCP server only (packages/mcp-server). SERVER-SIDE SECRET. Never expose to the
# browser, never commit, never paste into chat. Bypasses RLS: the server locks every
# operation to JWORD_OWNER_USER_ID, but a leaked key has full database authority.
# ---------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Tests: put the LOCAL stack values in .env.test.local (same variable names as above plus
# SUPABASE_DB_URL). Test suites refuse to run against a non-local URL because they create and
# delete users. .env.local may point at the hosted project for real use.
# ---------------------------------------------------------------------------
# Owner email to provision with `pnpm owner:create` (also used by Playwright).
JWORD_OWNER_EMAIL=
# Direct Postgres URL for fault-injection tests: postgresql://postgres:postgres@127.0.0.1:54329/postgres
SUPABASE_DB_URL=

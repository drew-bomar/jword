{
  "name": "@jword/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that reads a job posting and reviews it in an in-page jword overlay.",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@jword/core": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/chrome": "^0.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "happy-dom": "^20.0.0",
    "postcss": "8.5.28",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}

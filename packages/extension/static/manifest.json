{
  "manifest_version": 3,
  "name": "jword capture",
  "version": "0.1.0",
  "description": "Read the job posting in the current tab into your jword tracker, reviewed in the side panel.",
  "action": {
    "default_title": "Capture this job in jword"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+J"
      },
      "description": "Capture this job in jword"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}

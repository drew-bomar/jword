{
  "name": "@jword/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local stdio MCP server exposing bounded jword tools to a coding agent.",
  "bin": {
    "jword-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --external:@supabase/supabase-js --external:@modelcontextprotocol/sdk --external:zod --log-level=warning",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@jword/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.116.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
